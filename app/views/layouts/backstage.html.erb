<!DOCTYPE html>
<html>
  <head>
    <title>Backstage — Live Music Locator</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen">
    <nav class="bg-gray-950 text-white px-6 py-0 flex items-center justify-between shadow-lg">
      <div class="flex items-center gap-1">
        <span class="font-bold text-base tracking-tight mr-4 py-4">
          <%= link_to backstage_root_path, class: "flex items-center gap-2 text-white hover:text-indigo-300 transition-colors" do %>
            <span class="text-indigo-400 text-lg">&#9654;</span> LML Backstage
          <% end %>
        </span>
        <% if user_signed_in? %>
          <%= link_to "Dashboard", backstage_root_path, class: "text-gray-200 hover:text-white text-sm px-3 py-4 border-b-2 border-transparent hover:border-indigo-400 transition-all" %>
          <%= link_to "My Proposals", backstage_proposals_path, class: "text-gray-200 hover:text-white text-sm px-3 py-4 border-b-2 border-transparent hover:border-indigo-400 transition-all" %>
          <%= link_to "+ New Proposal", new_backstage_proposal_path, class: "text-gray-200 hover:text-white text-sm px-3 py-4 border-b-2 border-transparent hover:border-indigo-400 transition-all" %>
          <% if current_user.admin? %>
            <%= link_to "API Tokens", backstage_api_tokens_path, class: "text-gray-200 hover:text-white text-sm px-3 py-4 border-b-2 border-transparent hover:border-indigo-400 transition-all" %>
          <% end %>
        <% end %>
      </div>
      <div class="flex items-center gap-3 text-sm">
        <% if user_signed_in? %>
          <span class="text-gray-400 text-xs"><%= current_user.display_name.presence || current_user.email %></span>
          <%= link_to "Sign out", destroy_user_session_path, data: { turbo_method: :delete },
              class: "text-gray-200 hover:text-white border border-gray-600 hover:border-gray-400 rounded-md px-3 py-1.5 transition-all text-xs" %>
        <% else %>
          <%= link_to "Sign in", new_user_session_path, class: "text-gray-200 hover:text-white transition-colors" %>
          <%= link_to "Register", new_user_registration_path,
              class: "bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-1.5 rounded-md transition-colors font-medium" %>
        <% end %>
      </div>
    </nav>

    <main class="max-w-4xl mx-auto px-6 py-10">
      <% if notice %>
        <div class="mb-6 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl px-4 py-3 flex items-center gap-2">
          <span class="text-emerald-500">&#10003;</span> <%= notice %>
        </div>
      <% end %>
      <% if alert %>
        <div class="mb-6 bg-red-50 border border-red-200 text-red-800 rounded-xl px-4 py-3 flex items-center gap-2">
          <span class="text-red-500">&#9888;</span> <%= alert %>
        </div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
