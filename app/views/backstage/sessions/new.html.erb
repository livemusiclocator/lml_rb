<div class="max-w-md mx-auto">
  <div class="text-center mb-8">
    <p class="text-3xl mb-2">&#9654;</p>
    <h1 class="text-2xl font-bold tracking-tight">Sign in to Backstage</h1>
    <p class="text-gray-500 mt-1 text-sm">Propose changes to gigs and acts on Live Music Locator.</p>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-8">
    <%= form_for(resource, as: resource_name, url: user_session_path, html: { class: "space-y-4" }) do |f| %>
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>
      <div>
        <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.password_field :password, autocomplete: "current-password",
            class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>
      <div class="flex items-center gap-2">
        <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
        <%= f.label :remember_me, class: "text-sm text-gray-600" %>
      </div>
      <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-medium py-2.5 rounded-xl transition-colors">Sign in</button>
    <% end %>
  </div>

  <div class="text-center mt-6 space-y-2">
    <p class="text-sm text-gray-500">
      No account? <%= link_to "Register here", new_user_registration_path, class: "text-indigo-600 hover:text-indigo-800 font-medium" %>
    </p>
    <p class="text-sm text-gray-500">
      <%= link_to "Forgot your password?", new_user_password_path, class: "text-indigo-600 hover:text-indigo-800" %>
    </p>
  </div>
</div>
