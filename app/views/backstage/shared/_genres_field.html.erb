<% input = "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
<%= render layout: "backstage/shared/line_list_field",
      locals: { name: name, value: value, id: id, textarea_class: textarea_class, add_label: "+ Add a genre",
                placeholder: "indie rock\npost-punk" } do %>
  <input type="text" data-field="genre"
         data-action="input->line-list#sync keydown.enter->line-list#next paste->line-list#paste"
         placeholder="Genre" aria-label="Genre" autocomplete="off" class="<%= input %> flex-1">
<% end %>
