<div class="max-w-md mx-auto">
  <div class="text-center mb-8">
    <p class="text-3xl mb-2">&#9654;</p>
    <h1 class="text-2xl font-bold tracking-tight">Create a Backstage account</h1>
    <p class="text-gray-500 mt-1 text-sm">Register to propose new gigs, genre tags, set times and other details.</p>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-8">
    <%= form_for(resource, as: resource_name, url: user_registration_path, html: { class: "space-y-4" }) do |f| %>
      <% if resource.errors.any? %>
        <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg px-4 py-3 text-sm">
          <% resource.errors.full_messages.each do |msg| %>
            <p><%= msg %></p>
          <% end %>
        </div>
      <% end %>

      <div>
        <%= f.label :display_name, "Display name (optional)", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.text_field :display_name, autocomplete: "name",
            class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>
      <div>
        <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.password_field :password, autocomplete: "new-password",
            class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>
      <div>
        <%= f.label :password_confirmation, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
            class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>
      <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-medium py-2.5 rounded-xl transition-colors">Create account</button>
    <% end %>
  </div>

  <div class="text-center mt-6">
    <p class="text-sm text-gray-500">
      Already registered? <%= link_to "Sign in", new_user_session_path, class: "text-indigo-600 hover:text-indigo-800 font-medium" %>
    </p>
  </div>
</div>
