<div class="mb-8">
  <%= link_to "‹ #{@venue.name}", backstage_venue_path(@venue), class: "text-sm text-gray-500 hover:text-gray-700" %>
  <h1 class="text-3xl font-bold tracking-tight mt-1">Add a gig</h1>
  <p class="text-gray-500 mt-1">At <%= @venue.name %>. It goes live as soon as you save it.</p>
</div>

<%= render "form", gig: @gig, venue: @venue, url: backstage_venue_gigs_path(@venue), method: :post, submit_label: "Add gig" %>
