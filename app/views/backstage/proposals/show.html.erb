<div class="max-w-2xl">
  <div class="flex items-center gap-3 mb-8">
    <h1 class="text-3xl font-bold tracking-tight">Proposal</h1>
    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold
      <%= @proposal.pending? ? 'bg-amber-100 text-amber-800' : @proposal.approved? ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700' %>">
      <%= @proposal.status.capitalize %>
    </span>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
    <div class="px-6 py-5 border-b border-gray-100">
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-1">Target</p>
      <p class="text-gray-900 font-medium"><%= @proposal.target_label %></p>
    </div>

    <div class="px-6 py-5 border-b border-gray-100">
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-3">Proposed changes</p>
      <dl class="space-y-2">
        <% @proposal.proposed_attributes.each do |key, value| %>
          <div class="flex gap-4 text-sm">
            <dt class="font-medium text-gray-500 w-36 flex-shrink-0"><%= key.humanize %></dt>
            <% val = Array(value).join(", ").presence %>
            <dd class="text-gray-900"><% if val %><%= val %><% else %><span class="text-gray-400 italic">(blank)</span><% end %></dd>
          </div>
        <% end %>
      </dl>
    </div>

    <% if @proposal.note.present? %>
      <div class="px-6 py-5 border-b border-gray-100">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-1">Your note</p>
        <p class="text-sm text-gray-700 italic"><%= @proposal.note %></p>
      </div>
    <% end %>

    <% if @proposal.reviewer_note.present? %>
      <div class="px-6 py-5 border-b border-gray-100 bg-gray-50">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-1">Editor's note</p>
        <p class="text-sm text-gray-700"><%= @proposal.reviewer_note %></p>
      </div>
    <% end %>

    <div class="px-6 py-4 bg-gray-50 text-xs text-gray-400 flex flex-wrap gap-x-4 gap-y-1">
      <span>Submitted <%= @proposal.created_at.strftime("%d %b %Y at %H:%M") %></span>
      <% if @proposal.reviewed_at %>
        <span>&middot; Reviewed <%= @proposal.reviewed_at.strftime("%d %b %Y at %H:%M") %></span>
      <% end %>
    </div>
  </div>

  <div class="mt-6">
    <%= link_to "← Back to my proposals", backstage_proposals_path, class: "text-indigo-600 hover:text-indigo-800 text-sm font-medium" %>
  </div>
</div>
