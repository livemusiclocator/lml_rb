<div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
  <%= form_with url: backstage_proposals_path, method: :post, html: { class: "space-y-5" } do |f| %>
    <%= hidden_field_tag "proposal[proposed_type]", "Lml::Gig" %>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="sm:col-span-2">
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Gig name / headliner</label>
        <input type="text" name="proposal[proposed_attributes][name]" required
          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
          placeholder="e.g. King Stingray with Gut Health">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Date</label>
        <input type="date" name="proposal[proposed_attributes][date]" required
          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Venue</label>
        <div data-controller="autocomplete"
             data-autocomplete-url-value="<%= backstage_search_venues_path %>"
             class="relative">
          <input type="text"
                 data-autocomplete-target="input"
                 data-action="input->autocomplete#search focus->autocomplete#search blur->autocomplete#clear"
                 placeholder="Type to search venues..."
                 autocomplete="off"
                 required
                 class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
          <input type="hidden" name="proposal[proposed_attributes][venue_id]" data-autocomplete-target="hidden">
          <div data-autocomplete-target="results"
               class="hidden absolute z-10 w-full bg-white border border-gray-200 rounded-lg shadow-lg mt-1 divide-y divide-gray-100 max-h-60 overflow-y-auto">
          </div>
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Start time</label>
        <input type="time" name="proposal[proposed_attributes][start_time]"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Ticketing URL</label>
        <input type="url" name="proposal[proposed_attributes][ticketing_url]"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
          placeholder="https://...">
      </div>
      <div class="sm:col-span-2">
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Set list <span class="text-gray-400 font-normal">(one act per line)</span></label>
        <textarea name="proposal[proposed_attributes][set_list]" rows="4"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
          placeholder="Gut Health&#10;King Stingray"></textarea>
      </div>
      <div class="sm:col-span-2">
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Description</label>
        <textarea name="proposal[proposed_attributes][description]" rows="3"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"></textarea>
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1.5">Note for the editors <span class="text-gray-400 font-normal">(optional)</span></label>
      <textarea name="proposal[note]" rows="2"
        class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
        placeholder="e.g. I'm organising this event"></textarea>
    </div>

    <button type="submit" class="bg-indigo-600 hover:bg-indigo-500 text-white font-medium px-6 py-2.5 rounded-xl shadow-sm transition-colors">
      Submit proposal
    </button>
  <% end %>
</div>
