<div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
  <%= form_with url: backstage_proposals_path, method: :post, html: { class: "space-y-5" } do |f| %>
    <%= hidden_field_tag :target_type, "Lml::Gig" %>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1.5">Venue <span class="text-gray-400 font-normal">(optional — narrows the gig search)</span></label>
      <div data-controller="autocomplete"
           data-autocomplete-url-value="<%= backstage_search_venues_path %>"
           class="relative">
        <input type="text"
               data-autocomplete-target="input"
               data-action="input->autocomplete#search focus->autocomplete#search blur->autocomplete#clear"
               placeholder="All venues"
               autocomplete="off"
               class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
        <input type="hidden" id="gig-venue-filter" data-autocomplete-target="hidden">
        <div data-autocomplete-target="results"
             class="hidden absolute z-10 w-full bg-white border border-gray-200 rounded-lg shadow-lg mt-1 divide-y divide-gray-100 max-h-60 overflow-y-auto">
        </div>
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1.5">Which gig?</label>
      <div data-controller="autocomplete"
           data-autocomplete-url-value="<%= backstage_search_gigs_path %>"
           data-autocomplete-extras-value="#gig-venue-filter:venue_id"
           class="relative">
        <input type="text"
               data-autocomplete-target="input"
               data-action="input->autocomplete#search focus->autocomplete#search blur->autocomplete#clear"
               placeholder="Type to search gigs..."
               autocomplete="off"
               class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
        <input type="hidden" name="target_id" data-autocomplete-target="hidden">
        <div data-autocomplete-target="results"
             class="hidden absolute z-10 w-full bg-white border border-gray-200 rounded-lg shadow-lg mt-1 divide-y divide-gray-100 max-h-60 overflow-y-auto">
        </div>
      </div>
    </div>

    <div class="border border-gray-200 rounded-lg p-5">
      <p class="text-sm font-semibold text-gray-700 mb-4">Proposed changes <span class="font-normal text-gray-400">(leave blank if no change)</span></p>
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-gray-600 mb-1.5">Genre tags <span class="text-gray-400">(one per line)</span></label>
          <textarea name="proposal[proposed_attributes][genre_tags]" rows="3"
            class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
            placeholder="rock&#10;indie&#10;shoegaze"></textarea>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-gray-600 mb-1.5">Start time</label>
            <input type="time" name="proposal[proposed_attributes][start_time]"
              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-600 mb-1.5">Finish time</label>
            <input type="time" name="proposal[proposed_attributes][finish_time]"
              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-600 mb-1.5">Ticketing URL</label>
          <input type="url" name="proposal[proposed_attributes][ticketing_url]"
            class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
            placeholder="https://...">
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-600 mb-1.5">Set list <span class="text-gray-400">(one act per line)</span></label>
          <textarea name="proposal[proposed_attributes][set_list]" rows="4"
            class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
            placeholder="Gut Health&#10;King Stingray"></textarea>
        </div>
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1.5">Note for the editors <span class="text-gray-400 font-normal">(optional)</span></label>
      <textarea name="proposal[note]" rows="2"
        class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
        placeholder="e.g. I'm playing this show, doors at 7 not 8"></textarea>
    </div>

    <button type="submit" class="bg-indigo-600 hover:bg-indigo-500 text-white font-medium px-6 py-2.5 rounded-xl shadow-sm transition-colors">
      Submit proposal
    </button>
  <% end %>
</div>
