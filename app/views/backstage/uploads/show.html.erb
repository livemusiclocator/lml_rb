<div class="mb-8">
  <%= link_to "‹ Uploads", backstage_uploads_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  <h1 class="text-3xl font-bold tracking-tight mt-1">Upload <%= l(@upload.created_at.in_time_zone, format: :short) %></h1>
  <p class="text-gray-500 mt-1">
    <%= @upload.venue&.name || "No venue" %>
    <% if @upload.source.present? %>&middot; source <%= @upload.source %><% end %>
    <% if @upload.user %>&middot; by <%= @upload.user.display_name.presence || @upload.user.email %><% end %>
    &middot; <span class="<%= @upload.status == 'Failed' ? 'text-red-700 font-medium' : '' %>"><%= @upload.status.presence || "not processed" %></span>
  </p>
  <% if @upload.error_description.present? %>
    <div class="mt-4 bg-red-50 border border-red-200 text-red-800 rounded-lg px-4 py-3 text-sm">
      <%= @upload.error_description %>
    </div>
  <% end %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
  <section class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-semibold text-gray-900">Gigs it put in (<%= @gigs.size %>)</h2>
      <% if @gigs.any? %>
        <%= link_to "Review them", backstage_reviews_path(who: "everyone", upload_id: @upload.id),
            class: "text-sm text-indigo-600 hover:text-indigo-800 font-medium" %>
      <% end %>
    </div>
    <% if @gigs.any? %>
      <ul class="space-y-2 text-sm">
        <% @gigs.each do |gig| %>
          <li class="flex justify-between gap-4">
            <%= link_to gig.name, edit_backstage_gig_path(gig), class: "text-indigo-600 hover:text-indigo-800 truncate" %>
            <span class="text-gray-500 whitespace-nowrap">
              <%= gig.date&.strftime("%a %-d %b") %><% if gig.checked? %> &middot; checked<% end %><% if gig.hidden? %> &middot; hidden<% end %>
            </span>
          </li>
        <% end %>
      </ul>
      <p class="text-xs text-gray-400 mt-4">A gig shows here while this is the latest upload to have touched it.</p>
    <% else %>
      <p class="text-sm text-gray-400 italic">None.</p>
    <% end %>
  </section>

  <section class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
    <% with_ids = @upload.content_with_ids %>
    <% if with_ids != @upload.content %>
      <h2 class="font-semibold text-gray-900 mb-1">To send again</h2>
      <p class="text-xs text-gray-500 mb-4">
        What was sent, with each gig's id added. Paste this next time and every entry updates its own gig, even one renamed since.
      </p>
      <pre class="text-xs text-gray-700 whitespace-pre-wrap break-words max-h-[40rem] overflow-y-auto"><%= with_ids %></pre>
    <% else %>
      <h2 class="font-semibold text-gray-900 mb-4">What was sent</h2>
      <pre class="text-xs text-gray-700 whitespace-pre-wrap break-words max-h-[40rem] overflow-y-auto"><%= @upload.content %></pre>
    <% end %>
  </section>
</div>
