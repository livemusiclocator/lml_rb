<div class="mb-8 flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-3xl font-bold tracking-tight">Uploads</h1>
    <p class="text-gray-500 mt-1">Gigs sent in bulk, in the clipper format - from here, or from a script with an API token.</p>
    <% if @source %>
      <p class="text-sm text-gray-500 mt-2">
        Showing only source <%= @source %>.
        <%= link_to "Show all of them", backstage_uploads_path(who: @who), class: "text-indigo-600 hover:text-indigo-800 underline" %>
      </p>
    <% end %>
  </div>
  <%= link_to new_backstage_upload_path,
      class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-500 text-white font-medium px-5 py-2.5 rounded-xl shadow-sm transition-colors" do %>
    <span class="text-lg leading-none">+</span> New upload
  <% end %>
</div>

<nav class="flex gap-2 mb-6" aria-label="Whose uploads">
  <% { "mine" => "Yours", "everyone" => "Everyone's" }.each do |who, label| %>
    <% current = @who == who %>
    <%= link_to label, backstage_uploads_path(who: who, source: @source),
        aria: { current: current ? "page" : nil },
        class: "inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium border #{current ? 'bg-indigo-600 border-indigo-600 text-white' : 'bg-white border-gray-300 text-gray-700 hover:bg-gray-50'}" %>
  <% end %>
</nav>

<% if @uploads.empty? %>
  <div class="bg-white border border-dashed border-gray-300 rounded-xl p-8 text-center text-gray-500">
    <p>No uploads here yet.</p>
  </div>
<% else %>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left text-gray-500">
        <tr>
          <th class="px-4 py-3 font-medium">When</th>
          <th class="px-4 py-3 font-medium">Venue</th>
          <th class="px-4 py-3 font-medium">Source</th>
          <th class="px-4 py-3 font-medium">By</th>
          <th class="px-4 py-3 font-medium">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @uploads.each do |upload| %>
          <tr>
            <td class="px-4 py-3 whitespace-nowrap">
              <%= link_to l(upload.created_at.in_time_zone, format: :short), backstage_upload_path(upload),
                  class: "text-indigo-600 hover:text-indigo-800 font-medium" %>
            </td>
            <td class="px-4 py-3"><%= upload.venue&.name || "-" %></td>
            <td class="px-4 py-3">
              <% if upload.source.present? %>
                <%= link_to upload.source, backstage_uploads_path(who: @who, source: upload.source), class: "hover:underline" %>
              <% end %>
            </td>
            <td class="px-4 py-3 text-gray-500"><%= upload.user ? (upload.user.display_name.presence || upload.user.email) : "-" %></td>
            <td class="px-4 py-3">
              <span class="<%= upload.status == 'Failed' ? 'text-red-700' : 'text-gray-700' %>"><%= upload.status.presence || "-" %></span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="flex justify-between text-sm mt-4">
    <% if @page > 1 %>
      <%= link_to "‹ Newer", backstage_uploads_path(who: @who, source: @source, page: @page - 1), class: "text-indigo-600 hover:text-indigo-800" %>
    <% else %>
      <span></span>
    <% end %>
    <% if @more %>
      <%= link_to "Older ›", backstage_uploads_path(who: @who, source: @source, page: @page + 1), class: "text-indigo-600 hover:text-indigo-800" %>
    <% end %>
  </div>
<% end %>
