<div class="max-w-md mx-auto">
  <div class="text-center mb-8">
    <p class="text-3xl mb-2">&#9654;</p>
    <h1 class="text-2xl font-bold tracking-tight">Choose a new password</h1>
    <p class="text-gray-500 mt-1 text-sm">Enter your new password below.</p>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-8">
    <%= form_for(resource, as: resource_name, url: user_password_path, html: { method: :put, class: "space-y-4" }) do |f| %>
      <% if resource.errors.any? %>
        <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg px-4 py-3 text-sm">
          <% resource.errors.full_messages.each do |msg| %>
            <p><%= msg %></p>
          <% end %>
        </div>
      <% end %>

      <%= f.hidden_field :reset_password_token %>

      <div>
        <%= f.label :password, "New password", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password",
            class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>
      <div>
        <%= f.label :password_confirmation, "Confirm new password", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
            class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>
      <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-medium py-2.5 rounded-xl transition-colors">Update password</button>
    <% end %>
  </div>
</div>
