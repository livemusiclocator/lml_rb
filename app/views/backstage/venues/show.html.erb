<div class="mb-8 flex flex-wrap items-end justify-between gap-4">
  <div>
    <%= link_to current_user.admin? ? "‹ Venues" : "‹ My venues", backstage_venues_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
    <h1 class="text-3xl font-bold tracking-tight mt-1"><%= @venue.name %></h1>
    <p class="text-gray-500 mt-1"><%= [@venue.address, @venue.location].compact_blank.join(" · ") %></p>
    <% unless current_user.manages_venue?(@venue) %>
      <p class="text-xs text-amber-700 mt-2">You don't manage this venue - you can change it because you're an admin.</p>
    <% end %>
  </div>
  <%= link_to new_backstage_venue_gig_path(@venue),
      class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-500 text-white font-medium px-5 py-2.5 rounded-xl shadow-sm transition-colors" do %>
    <span class="text-lg leading-none">+</span> Add a gig
  <% end %>
</div>

<section class="mb-10">
  <h2 class="font-semibold text-gray-900 mb-3">Upcoming gigs</h2>
  <% if @upcoming.any? %>
    <%= render "gig_list", gigs: @upcoming %>
  <% else %>
    <p class="text-sm text-gray-400 italic">Nothing coming up.</p>
  <% end %>
</section>

<% if @past.any? %>
  <section>
    <h2 class="font-semibold text-gray-900 mb-3">Recent gigs</h2>
    <%= render "gig_list", gigs: @past %>
  </section>
<% end %>
