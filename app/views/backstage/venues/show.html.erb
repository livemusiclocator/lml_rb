<div class="mb-8">
  <%= link_to "‹ My venues", backstage_venues_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  <h1 class="text-3xl font-bold tracking-tight mt-1"><%= @venue.name %></h1>
  <p class="text-gray-500 mt-1"><%= [@venue.address, @venue.location].compact_blank.join(" · ") %></p>
</div>

<section class="mb-10">
  <h2 class="font-semibold text-gray-900 mb-3">Upcoming gigs</h2>
  <% if @upcoming.any? %>
    <%= render "gig_list", gigs: @upcoming %>
  <% else %>
    <p class="text-sm text-gray-400 italic">Nothing coming up.</p>
  <% end %>
</section>

<% if @past.any? %>
  <section>
    <h2 class="font-semibold text-gray-900 mb-3">Recent gigs</h2>
    <%= render "gig_list", gigs: @past %>
  </section>
<% end %>
