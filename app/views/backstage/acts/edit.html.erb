<div class="mb-8">
  <%= link_to "‹ Acts", backstage_acts_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  <h1 class="text-3xl font-bold tracking-tight mt-1"><%= @act.name_was %></h1>
  <p class="mt-2 flex items-center gap-3"><%= short_link_with_copy(@act, link_class: "text-sm text-indigo-600 hover:text-indigo-800", button_class: "text-sm font-medium text-indigo-600 hover:text-indigo-800 cursor-pointer") %></p>
</div>

<%= render "form", act: @act, url: backstage_act_path(@act), method: :patch, submit_label: "Save act" %>
