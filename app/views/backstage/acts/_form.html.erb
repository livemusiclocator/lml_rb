<% field = "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
<% label = "block text-sm font-medium text-gray-700 mb-1.5" %>
<% hint = "text-gray-400 font-normal" %>

<div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
  <%= form_with model: act, scope: :act, url: url, method: method, html: { class: "space-y-5" } do |f| %>
    <% if act.errors.any? %>
      <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg px-4 py-3 text-sm">
        <%= act.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="sm:col-span-2">
        <%= f.label :name, class: label %>
        <%= f.text_field :name, required: true, class: field %>
      </div>
      <div>
        <%= f.label :location, class: label do %>
          Location <span class="<%= hint %>">(e.g. melbourne)</span>
        <% end %>
        <%= f.text_field :location, class: field %>
      </div>
      <div>
        <%= f.label :country, class: label %>
        <%= f.text_field :country, class: field %>
      </div>
      <div class="sm:col-span-2">
        <%= f.label :genre_list, class: label do %>
          Genres <span class="<%= hint %>">(separated by commas)</span>
        <% end %>
        <%= f.text_field :genre_list, class: field, placeholder: "indie rock, post-punk" %>
      </div>
      <div class="sm:col-span-2">
        <%= f.label :alias_list, class: label do %>
          Also known as <span class="<%= hint %>">(other names, separated by commas)</span>
        <% end %>
        <%= f.text_field :alias_list, class: field %>
      </div>
      <div>
        <%= f.label :website, class: label %>
        <%= f.url_field :website, class: field, placeholder: "https://..." %>
      </div>
      <div>
        <%= f.label :email, class: label %>
        <%= f.email_field :email, class: field %>
      </div>
      <% [
        [:instagram, "Instagram handle", "yourband"],
        [:facebook, "Facebook handle", "yourband"],
        [:linktree, "Linktree handle", "yourband"],
        [:bandcamp, "Bandcamp name", "yourband"],
        [:spotify, "Spotify artist ID", ""],
        [:youtube, "YouTube channel", "@yourband"],
        [:musicbrainz, "MusicBrainz ID", ""],
        [:rym, "Rate Your Music", ""],
        [:wikipedia, "Wikipedia", ""],
      ].each do |attribute, text, placeholder| %>
        <div>
          <%= f.label attribute, text, class: label %>
          <%= f.text_field attribute, class: field, placeholder: placeholder %>
        </div>
      <% end %>
    </div>

    <div class="flex items-center gap-4">
      <%= f.submit submit_label, class: "bg-indigo-600 hover:bg-indigo-500 text-white font-medium px-6 py-2.5 rounded-xl shadow-sm transition-colors cursor-pointer" %>
      <%= link_to "Cancel", backstage_acts_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
    </div>
  <% end %>
</div>
